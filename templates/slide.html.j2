<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<style>
{% for w in [400,500,700,800] %}
@font-face{font-family:"Jakarta";font-weight:{{w}};src:url("fonts/plus-jakarta-sans-latin-{{w}}-normal.woff2") format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
@font-face{font-family:"Jakarta";font-weight:{{w}};src:url("fonts/plus-jakarta-sans-latin-ext-{{w}}-normal.woff2") format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}
{% endfor %}
{% for st in ["normal","italic"] %}
@font-face{font-family:"Serif";font-style:{{st}};src:url("fonts/instrument-serif-latin-400-{{st}}.woff2") format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
@font-face{font-family:"Serif";font-style:{{st}};src:url("fonts/instrument-serif-latin-ext-400-{{st}}.woff2") format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}
{% endfor %}

:root{
  --bg:{{ '#083B47' if theme == 'facts' else '#0F1626' }};
  --card:{{ '#0D4B57' if theme == 'facts' else '#172036' }};
  --line:rgba(253,247,236,.10);
  --cream:#FDF7EC; --muted:rgba(253,247,236,.66); --faint:rgba(253,247,236,.38);
  --coral:{{ '#56D7B4' if theme == 'facts' else '#FC6456' }};
  --amber:{{ '#B8F36B' if theme == 'facts' else '#FFB132' }};
  --accent:{{ accent|default('#FFB132') }};
  --k:1;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:1080px;height:1350px;background:var(--bg);overflow:hidden}
body{font-family:"Jakarta",sans-serif;color:var(--cream);-webkit-font-smoothing:antialiased;text-rendering:geometricPrecision}
.slide{position:relative;width:1080px;height:1350px;padding:84px 88px 76px;display:flex;flex-direction:column;overflow:hidden}
/* soft brand glow */
.glow{position:absolute;inset:0;pointer-events:none;
  background:
    radial-gradient(640px 520px at 100% 0%, color-mix(in srgb,var(--accent) 22%, transparent), transparent 70%),
    radial-gradient(520px 420px at 0% 100%, rgba(252,100,86,.10), transparent 70%);}
.grain{position:absolute;inset:0;pointer-events:none;opacity:.05;
  background-image:repeating-linear-gradient(0deg,rgba(255,255,255,.5) 0 1px,transparent 1px 3px)}
.top{position:relative;display:flex;align-items:center;justify-content:space-between;font-size:24px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--faint)}
.brand{display:flex;align-items:center;gap:18px;color:var(--muted)}
.brand img{height:46px}
.pager{font-variant-numeric:tabular-nums}
.foot{position:relative;margin-top:auto;display:flex;align-items:center;justify-content:space-between;padding-top:34px;border-top:1px solid var(--line);font-size:25px;font-weight:600;color:var(--faint)}
.foot .swipe{display:flex;align-items:center;gap:12px;color:var(--muted)}
.foot .swipe svg{width:30px;height:30px}
.hl em{font-family:"Serif";font-style:italic;font-weight:400;color:var(--accent);letter-spacing:0;font-size:1.12em;line-height:.9}

/* ---------- category slide ---------- */
.cat{position:relative;margin-top:84px;display:flex;align-items:center;gap:22px}
.cat .ico{width:78px;height:78px;border-radius:22px;display:grid;place-items:center;
  background:color-mix(in srgb,var(--accent) 16%, transparent);border:1.5px solid color-mix(in srgb,var(--accent) 40%, transparent)}
.cat .ico svg{width:40px;height:40px;stroke:var(--accent)}
.cat .name{font-size:30px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
.cat .no{margin-left:auto;font-family:"Serif";font-size:112px;line-height:.7;color:color-mix(in srgb,var(--accent) 34%, transparent)}
.body{position:relative;flex:1;display:flex;flex-direction:column;min-height:0;padding-bottom:30px}
.body>*{flex-shrink:0}
.body .hl{margin-top:48px;font-size:calc(76px*var(--k));font-weight:800;line-height:1.07;letter-spacing:-.025em;text-wrap:balance}
.items{margin-top:calc(50px*var(--k));margin-bottom:calc(44px*var(--k));display:flex;flex-direction:column;gap:calc(34px*var(--k))}
.item{display:grid;grid-template-columns:8px 1fr;gap:28px}
.item .bar{border-radius:4px;background:var(--accent)}
.item b{display:block;font-size:calc(35px*var(--k));font-weight:700;line-height:1.2;letter-spacing:-.01em}
.item span{display:block;margin-top:8px;font-size:calc(30px*var(--k));font-weight:400;line-height:1.38;color:var(--muted)}
.fact{margin-top:auto;position:relative;background:var(--card);border:1px solid var(--line);border-radius:30px;padding:34px 38px 36px 38px}
.fact .lbl{display:flex;align-items:center;gap:12px;font-size:22px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--amber)}
.fact .lbl svg{width:28px;height:28px}
.fact p{margin-top:14px;font-size:calc(29px*var(--k));line-height:1.42;color:var(--cream)}
.src{margin-top:18px;font-size:21px;color:var(--faint);letter-spacing:.02em}

/* ---------- cover ---------- */
.cover .mark{margin-top:70px;height:150px;width:auto;align-self:flex-start}
.cover .date{margin-top:64px;font-family:"Serif";font-size:168px;line-height:.92;letter-spacing:-.01em}
.cover .date i{color:var(--amber)}
.cover .day{margin-top:18px;font-size:28px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.cover .title{margin-top:52px;font-size:46px;font-weight:800;letter-spacing:-.015em}
.cover .sub{margin-top:10px;font-size:30px;font-weight:500;color:var(--muted)}
.toc{margin-top:48px;display:flex;flex-direction:column;border-top:1px solid var(--line)}
.toc .row{display:grid;grid-template-columns:58px 262px 1fr;align-items:center;gap:16px;padding:24px 0;border-bottom:1px solid var(--line)}
.toc .dot{width:50px;height:50px;border-radius:15px;display:grid;place-items:center}
.toc .dot svg{width:24px;height:24px}
.toc .k{font-size:21px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
.toc .t{font-size:29px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* ---------- cta ---------- */
.cta{align-items:center;text-align:center}
.cta .mid{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center}
.cta .icon{width:260px;height:260px;border-radius:62px;box-shadow:0 40px 120px rgba(252,100,86,.25),0 0 0 1px var(--line)}
.cta h2{margin-top:70px;font-size:74px;font-weight:800;line-height:1.08;letter-spacing:-.025em;max-width:860px}
.cta h2 .nw{white-space:nowrap}
.cta h2 em{font-family:"Serif";font-style:italic;font-weight:400;color:var(--amber);font-size:1.12em}
.cta .pills{margin-top:60px;display:flex;gap:18px}
.cta .pill{display:flex;align-items:center;gap:12px;padding:22px 34px;border-radius:999px;border:1.5px solid var(--line);background:var(--card);font-size:28px;font-weight:700}
.cta .pill svg{width:30px;height:30px;stroke:var(--cream)}
.cta .pill.main{background:linear-gradient(135deg,var(--coral),var(--amber));border:0;color:#1a1208}
.cta .pill.main svg{stroke:#1a1208}
.cta .handle{margin-top:46px;font-size:34px;font-weight:700;color:var(--muted)}
.cta .foot{width:100%;justify-content:center}
</style>
</head>
<body>
{% macro icon(name, color) -%}
<svg viewBox="0 0 24 24" fill="none" stroke="{{ color|default('currentColor') }}" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
{% if name == 'chip' %}<rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5" rx=".8"/><path d="M9 2.5V6M15 2.5V6M9 18v3.5M15 18v3.5M2.5 9H6M2.5 15H6M18 9h3.5M18 15h3.5"/>
{% elif name == 'rocket' %}<path d="M5 15c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9a2.2 2.2 0 0 0-2.9-.1z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 0 1-4 2z"/><path d="M9 12H4s.6-3 2-4c1.6-1.1 5 0 5 0M12 15v5s3-.6 4-2c1.1-1.6 0-5 0-5"/>
{% elif name == 'trend' %}<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>
{% elif name == 'trophy' %}<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4"/>
{% elif name == 'film' %}<rect x="3" y="7" width="18" height="14" rx="2"/><path d="M3 11h18M3 7l2.5-4 3.5 1-2.5 4M9 4l4 1-2.5 4M13 5l4 1-2.5 3"/>
{% elif name == 'landmark' %}<path d="M3 21h18M4 10h16M12 3l8 5H4l8-5zM6 10v8M10 10v8M14 10v8M18 10v8"/>
{% elif name == 'flask' %}<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3"/><path d="M8 15h8"/>
{% elif name == 'scroll' %}<path d="M7 4h10a3 3 0 0 1 0 6H8a3 3 0 0 0 0 6h9a3 3 0 0 0 3-3V7"/><path d="M7 4a3 3 0 0 0 0 6"/>
{% elif name == 'book' %}<path d="M4 5a3 3 0 0 1 3-3h12v18H7a3 3 0 0 0-3 3V5z"/><path d="M7 2v18"/>
{% elif name == 'brain' %}<path d="M9 5a3 3 0 0 0-5 2 3 3 0 0 0 1 5 3 3 0 0 0 3 5h1v3h6v-3h1a3 3 0 0 0 3-5 3 3 0 0 0 1-5 3 3 0 0 0-5-2 3 3 0 0 0-6 0z"/>
{% elif name == 'leaf' %}<path d="M20 4C11 4 4 8 4 16c0 2 1 4 3 4 8 0 12-7 13-16z"/><path d="M4 20c3-4 7-7 12-9"/>
{% elif name == 'bookmark' %}<path d="M6 3h12v18l-6-4-6 4V3z"/>
{% elif name == 'plus' %}<path d="M12 5v14M5 12h14"/>
{% elif name == 'send' %}<path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
{% elif name == 'arrow' %}<path d="M5 12h14M13 6l6 6-6 6"/>
{% endif %}
</svg>
{%- endmacro %}
{% macro star() -%}
<svg viewBox="0 0 24 24"><defs><linearGradient id="sg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FC6456"/><stop offset="1" stop-color="#FFB132"/></linearGradient></defs>
<path d="M12 0C12.6 6.6 15.8 10.8 24 12C15.8 13.2 12.6 17.4 12 24C11.4 17.4 8.2 13.2 0 12C8.2 10.8 11.4 6.6 12 0Z" fill="url(#sg)"/></svg>
{%- endmacro %}

<div class="slide {{ kind }}">
  <div class="glow"></div>

  {% if kind != 'cta' %}
  <div class="top">
    <div class="brand"><img src="brand/logo-isaret.png" alt="">{{ brand_name }}</div>
    <div class="pager">{{ '%02d'|format(index) }} / {{ '%02d'|format(total) }}</div>
  </div>
  {% endif %}

  {% if kind == 'cover' %}
    <div class="date">{{ date_day }} <i>{{ date_month }}</i></div>
    <div class="day">{{ date_weekday }} · {{ date_year }}</div>
    <div class="title">{{ cover.title }}</div>
    <div class="sub">{{ cover.subtitle }}</div>
    <div class="toc">
      {% for c in categories %}
      <div class="row">
        <div class="dot" style="background:color-mix(in srgb,{{ c.color }} 16%,transparent)">{{ icon(c.icon, c.color) }}</div>
        <div class="k" style="color:{{ c.color }}">{{ c.label }}</div>
        <div class="t">{{ c.teaser }}</div>
      </div>
      {% endfor %}
    </div>
    <div class="foot"><span>{{ handle }}</span><span class="swipe">Kaydır {{ icon('arrow') }}</span></div>

  {% elif kind == 'category' %}
    <div class="cat">
      <div class="ico">{{ icon(c.icon) }}</div>
      <div class="name">{{ c.label }}</div>
      <div class="no">{{ '%02d'|format(c.n) }}</div>
    </div>
    <div class="body" id="fit">
      <h1 class="hl">{{ c.headline_html|safe }}</h1>
      <div class="items">
        {% for it in c["items"] %}
        <div class="item"><div class="bar"></div><div><b>{{ it.lead }}</b><span>{{ it.text }}</span></div></div>
        {% endfor %}
      </div>
      {% if c.fact %}
      <div class="fact">
        <div class="lbl">{{ star() }} Biliyor muydun?</div>
        <p>{{ c.fact }}</p>
      </div>
      {% endif %}
      {% if c.sources %}<div class="src">Kaynak: {{ c.sources|join(' · ') }}</div>{% endif %}
    </div>
    <div class="foot"><span>{{ handle }}</span><span class="swipe">{% if index < total %}Kaydır {{ icon('arrow') }}{% endif %}</span></div>

  {% elif kind == 'cta' %}
    <div class="mid">
      <img class="icon" src="brand/logo-ikon.png" alt="">
      <h2>{{ cta_html|safe }}</h2>
      <div class="pills">
        <div class="pill main">{{ icon('plus') }} Takip et</div>
        <div class="pill">{{ icon('bookmark') }} Kaydet</div>
        <div class="pill">{{ icon('send') }} Paylaş</div>
      </div>
      <div class="handle">{{ handle }}</div>
    </div>
  {% endif %}
</div>

<script>
// Metin taşarsa yazı boyutunu kademeli küçült (otomatik sığdırma)
window.fitText=function(){
  const box=document.getElementById('fit'); if(!box) return 1;
  let k=1; const root=document.documentElement;
  const over=()=>box.scrollHeight>box.clientHeight+1;
  // kısa metinde büyüt, uzun metinde küçült: alan her zaman dengeli dolsun
  while(!over() && k<1.16){ k+=0.03; root.style.setProperty('--k',k); }
  while(over() && k>0.62){ k-=0.03; root.style.setProperty('--k',k); }
  return +k.toFixed(2);
};
</script>
</body>
</html>
